# Minimal Ubuntu development image for building goestools from source.
#
# Usage from the repository root:
#
#   docker build -f docker/Dockerfile.ubuntu-dev -t goestools-ubuntu-dev .
#   docker run --rm -v "$PWD":/workspace -w /workspace goestools-ubuntu-dev
#
# The default command performs an out-of-tree build in ./build. Initialize
# submodules in the checkout first if they are not already populated:
#
#   git submodule update --init --recursive

ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  ca-certificates \
  cmake \
  git \
  libairspy-dev \
  libopencv-dev \
  libproj-dev \
  librtlsdr-dev \
  pkg-config \
  zlib1g-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["sh", "-lc", "mkdir -p build && cd build && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && cmake --build . -j$(nproc)"]
