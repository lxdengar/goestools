# Minimal Ubuntu image for building goestools from source.
#
# Usage from the repository root:
#
#   docker build -f docker/Dockerfile.ubuntu-dev -t goestools-ubuntu-dev .
#   docker run --rm -v "$PWD":/workspace -w /workspace goestools-ubuntu-dev
#
# The default command performs an out-of-tree build in ./build using
# scripts/modern_build.sh. Initialize submodules in the checkout first if they are
# not already populated:
#
#   git submodule update --init --recursive

ARG UBUNTU_VERSION=24.04
FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential \
  ca-certificates \
  cmake \
  git \
  libopencv-dev \
  pkg-config \
  zlib1g-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["scripts/modern_build.sh"]
